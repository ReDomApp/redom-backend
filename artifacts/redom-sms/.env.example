PORT=8090
DATABASE_URL=
SMS_API_KEY=
SMS_DEFAULT_SOURCE=ReDom
SMS_MAX_MESSAGE_LENGTH=1600
SMS_QUEUE_POLL_MS=1000
SMS_MAX_ATTEMPTS=8
SMS_RETRY_BASE_MS=5000
SMSC_ENABLED=false
SMSC_HOST=
SMSC_PORT=2775
SMSC_SYSTEM_ID=
SMSC_PASSWORD=
SMSC_SYSTEM_TYPE=
SMSC_TON=1
SMSC_NPI=1
SMSC_SOURCE_TON=5
SMSC_SOURCE_NPI=0
SMSC_DEST_TON=1
SMSC_DEST_NPI=1
SMSC_ENQUIRE_LINK_MS=30000
# Internal-only controls (never expose this to external API clients)
SMS_INTERNAL_KEY=replace-with-a-long-random-secret
SMS_WEBHOOK_MAX_ATTEMPTS=10
SMS_WEBHOOK_RETRY_BASE_SECONDS=2

# Optional multi-carrier routing. JSON credentials are loaded at process start.
# Countries use E.164 country calling codes without the leading +.
# SMPP_ROUTES_JSON=[{"id":"primary","host":"smpp.example.net","port":2775,"systemId":"...","password":"...","systemType":"","sourceTon":5,"sourceNpi":0,"destTon":1,"destNpi":1,"enquireLinkMs":30000,"countries":["234"],"priority":10,"enabled":true}]
