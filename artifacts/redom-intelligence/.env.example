SERVICE_API_KEYS=replace-with-at-least-32-random-characters
RATE_LIMIT_PER_MINUTE=60
PORT=8088

# Public model routes are advertised only when fully configured. No fallback.
AUREX_18_BASE_URL=http://vllm:8000
AUREX_18_API_KEY=replace-with-a-separate-inference-secret
AUREX_18_MODEL=aurex-1.8
AUREX_18_TIMEOUT_MS=90000

# Configure only when dedicated engines/models/capacity are available.
REX_68_BASE_URL=
REX_68_API_KEY=
REX_68_MODEL=
REX_68_TIMEOUT_MS=90000
