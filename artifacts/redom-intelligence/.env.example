# ReDom service-to-service credentials: use 32+ random characters per key.
# Keep this value in the secret manager; never commit real credentials.
SERVICE_API_KEYS=replace-with-at-least-32-random-characters
RATE_LIMIT_PER_MINUTE=60
PORT=8088

# Private OpenAI-compatible inference server. No cloud fallback exists.
INFERENCE_BASE_URL=http://vllm:8000
INFERENCE_API_KEY=replace-with-a-separate-inference-secret
INFERENCE_MODEL=redom-model
INFERENCE_TIMEOUT_MS=90000
