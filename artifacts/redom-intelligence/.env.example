SERVICE_API_KEYS=replace-with-at-least-32-random-characters
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_INFERENCE=8
PORT=8088
BRAVE_SEARCH_API_KEY=replace-with-a-Brave-Search-API-subscription-token

# OREX: general-purpose model endpoint
OREX_BASE_URL=http://orex-vllm:8000
OREX_API_KEY=replace-with-a-separate-orex-inference-secret
OREX_MODEL=orex
OREX_TIMEOUT_MS=90000

# APEX: dedicated reasoning model endpoint. Enable only after provisioning its engine.
APEX_BASE_URL=http://apex-vllm:8000
APEX_API_KEY=
APEX_MODEL=
APEX_TIMEOUT_MS=120000

# ULTRON: dedicated coding model endpoint. Enable only after provisioning its engine.
ULTRON_BASE_URL=http://ultron-vllm:8000
ULTRON_API_KEY=
ULTRON_MODEL=
ULTRON_TIMEOUT_MS=120000
