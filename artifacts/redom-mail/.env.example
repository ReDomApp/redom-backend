NODE_ENV=development
MAIL_ROLE=all
DATABASE_URL=postgresql://user:password@host/database
REQUIRE_DKIM=true
PORT=8080
MAIL_API_KEY=replace-with-a-long-random-key
SMTP_HOSTNAME=mail.wnncompany.com
SMTP_HELO_NAME=mail.wnncompany.com
SMTP_FROM_DOMAIN=wnncompany.com
SMTP_CONNECT_TIMEOUT_MS=15000
SMTP_COMMAND_TIMEOUT_MS=15000
SMTP_MAX_MESSAGE_BYTES=10485760
SMTP_RETRY_LIMIT=4
SMTP_RETRY_BASE_MS=5000
DKIM_SELECTOR=mail2026
DKIM_PRIVATE_KEY_PATH=/run/secrets/wnncompany-dkim.pem
