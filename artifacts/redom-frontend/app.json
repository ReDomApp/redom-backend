{
  "expo": {
    "name": "ReDom",
    "slug": "redom",
    "version": "7.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "redom",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.redom.app",
      "associatedDomains": ["applinks:redom.app"]
    },
    "android": {
      "package": "com.redom.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "redom.app",
              "pathPrefix": "/profile/username/"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1877F2"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "es", "fr", "de", "pt", "it", "nl", "ar", "zh", "ja", "ko", "hi", "ru", "tr"],
            "android": ["en", "es", "fr", "de", "pt", "it", "nl", "ar", "zh", "ja", "ko", "hi", "ru", "tr"]
          }
        }
      ]
    ]
  }
}
