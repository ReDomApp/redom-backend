{
  "expo": {
    "name": "ReDom",
    "slug": "redom",
    "version": "7.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "redom",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.redom.app",
      "associatedDomains": [
        "applinks:redom.app"
      ],
      "bitcode": false,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "es",
          "fr",
          "de",
          "pt",
          "it",
          "nl",
          "ar",
          "zh",
          "ja",
          "ko",
          "hi",
          "ru",
          "tr"
        ]
      }
    },
    "android": {
      "package": "com.redom.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "redom.app",
              "pathPrefix": "/profile/username/"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1877F2"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ReDom to access your microphone for voice messages and calls.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ReDom to scan encryption QR codes and capture photos.",
          "microphonePermission": "Allow ReDom to access your microphone for calls and media.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ReDom to unlock protected chats with Face ID."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow ReDom to access your camera for calls.",
          "microphonePermission": "Allow ReDom to access your microphone for calls."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es",
              "fr",
              "de",
              "pt",
              "it",
              "nl",
              "ar",
              "zh",
              "ja",
              "ko",
              "hi",
              "ru",
              "tr"
            ],
            "android": [
              "en",
              "es",
              "fr",
              "de",
              "pt",
              "it",
              "nl",
              "ar",
              "zh",
              "ja",
              "ko",
              "hi",
              "ru",
              "tr"
            ]
          }
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow ReDom to add events to your device calendar."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ff2a65f1-94f8-4751-8464-5eb32406c76c"
      }
    }
  }
}
